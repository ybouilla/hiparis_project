CLOUDFLARE_TUNNEL_TOKEN=
APP_REPLICAS=2
WEB_CONCURRENCY=2
PORT=5000
POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_DB=movies
DB_PORT=5432
# API requests per client address (sustained rate, and how many may come at once)
API_RATE_LIMIT=10r/s
API_RATE_BURST=40
# 1 lets any client skip the nginx cache with "X-No-Cache: 1": for load tests only
ALLOW_CACHE_BYPASS=0
# with the Cloudflare tunnel: the address range of the compose network (see the README)
TRUSTED_PROXY=127.0.0.1/32
